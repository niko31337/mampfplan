# Kopiere diese Datei nach ".env" und passe sie an.

# Namen der (zwei) Benutzer, kommagetrennt
MEMBERS=Niko,Partnerin

# Anzeigename der Familie
SPACE_NAME=Familie

# Optional: eigenes geheimes Token für den Link (mind. 22 Zeichen, zufällig!).
# Leer lassen = beim ersten Start wird ein sicheres Token erzeugt und im Log ausgegeben.
# SPACE_TOKEN=

# Öffentliche Adresse der App (nur für die Anzeige des Teilen-Links)
PUBLIC_URL=http://localhost:8000

# Auf true setzen, wenn die App hinter HTTPS (Reverse Proxy) läuft
SECURE_COOKIES=false

# Optional: Spoonacular als zusätzliche (englische) Rezeptquelle
# SPOONACULAR_API_KEY=

TIMEZONE=Europe/Berlin
