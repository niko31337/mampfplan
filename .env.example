# Copy this file to ".env" and adjust it. The ".env" file is never committed to the repository.

# Profiles and name of the first household (the admin household).
# Only used on the very first start; after that, households and profiles are managed in the app.
MEMBERS=Alex,Sam
SPACE_NAME=Family

# Optional: your own secret token for the link (at least 22 characters, random!).
# Leave empty = a secure token is generated on first start and printed in the log.
# SPACE_TOKEN=

# Public address of the app, only used to display the share link (including the port if it isn't 443)
PUBLIC_URL=http://localhost:8000

# Set to true once the app runs over HTTPS
SECURE_COOKIES=false

# Optional: Spoonacular as an additional (English) recipe source
# SPOONACULAR_API_KEY=

TIMEZONE=Europe/Berlin

# Image cache (recipe images are downloaded once by the server and served by the app itself)
# IMAGE_CACHE_MAX_MB=300
# IMAGE_CACHE_DIR=

# --- Only when running with Caddy (docker-compose.caddy.yml) ---
# Domain the app is reachable at (DNS must point to this server):
# DOMAIN=mampf.example.org
# Name of the certbot certificate = folder name under /etc/letsencrypt/live/ ("certbot certificates" shows it).
# Only set it if it differs from the domain (e.g. with a shared certificate):
# CERT_NAME=example.org
# certbot folder (default: /etc/letsencrypt):
# CERT_DIR=/etc/letsencrypt
# Then also set: PUBLIC_URL=https://mampf.example.org:8443  and  SECURE_COOKIES=true
# Enable both Compose files permanently (then "docker compose up -d" is enough):
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
