# Kopiere diese Datei nach ".env" und passe sie an. Die ".env" wird nie ins Repository eingecheckt.

# Profile und Name des ersten Haushalts (Verwaltungs-Haushalt).
# Wirken nur beim allerersten Start – danach werden Haushalte und Profile in der App verwaltet.
MEMBERS=Niko,Partnerin
SPACE_NAME=Familie

# Optional: eigenes geheimes Token für den Link (mind. 22 Zeichen, zufällig!).
# Leer lassen = beim ersten Start wird ein sicheres Token erzeugt und im Log ausgegeben.
# SPACE_TOKEN=

# Öffentliche Adresse der App – nur für die Anzeige des Teilen-Links (inkl. Port, falls nicht 443)
PUBLIC_URL=http://localhost:8000

# Auf true setzen, sobald die App über HTTPS läuft
SECURE_COOKIES=false

# Optional: Spoonacular als zusätzliche (englische) Rezeptquelle
# SPOONACULAR_API_KEY=

TIMEZONE=Europe/Berlin

# Bild-Cache (Rezeptbilder werden einmalig vom Server geladen und selbst ausgeliefert)
# IMAGE_CACHE_MAX_MB=300
# IMAGE_CACHE_DIR=

# --- Nur für den Betrieb mit Caddy (docker-compose.caddy.yml) ---
# Domain, unter der die App erreichbar ist (DNS muss auf diesen Server zeigen):
# DOMAIN=mampf.example.org
# Name des certbot-Zertifikats = Ordnername unter /etc/letsencrypt/live/ ("certbot certificates" zeigt ihn).
# Nur setzen, wenn er nicht der Domain entspricht (z. B. bei einem gemeinsamen Zertifikat):
# CERT_NAME=example.org
# Ordner des certbot (Standard: /etc/letsencrypt):
# CERT_DIR=/etc/letsencrypt
# Dann außerdem: PUBLIC_URL=https://mampf.example.org:8443  und  SECURE_COOKIES=true
# Beide Compose-Dateien dauerhaft aktivieren (dann genügt "docker compose up -d"):
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
