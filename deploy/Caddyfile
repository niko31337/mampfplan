# HTTPS reverse proxy in front of Mampfplan.
# Generic: domain and certificate name come from .env (DOMAIN, CERT_NAME); nothing
# environment-specific is in the repository.
#
# - Certificates come from the server's certbot (mounted read-only under /certs).
#   Caddy doesn't obtain certificates itself (auto_https off).
# - After certbot renews a certificate, Caddy has to reload (see README, "deploy hook").
# - Access logs are off in Caddy by default: the secret link in the URL path never ends up in a log file.
{
	auto_https off
}

{$DOMAIN}:8443 {
	tls /certs/live/{$CERT_NAME}/fullchain.pem /certs/live/{$CERT_NAME}/privkey.pem
	encode zstd gzip
	reverse_proxy mampfplan:8000
}

# Further proxies on this server (e.g. Home Assistant) only live on the server, not in the
# repository: deploy.local/sites/*.caddy (see README, "More services behind the same Caddy").
import /etc/caddy/sites/*.caddy
